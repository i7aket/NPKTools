@inherits LayoutComponentBase
@inject Translations T

<header class="app-header">
    @*
        The mark carries the brand and the heading carries the product, so the two are not competing
        to be the title. Decorative: the brand is written out beside it, and a screen reader that
        announced both would say the same thing twice.
    *@
    <img class="brand-mark" src="img/greensecrets.png" width="32" height="32" alt="" />
    <span class="brand">@T["app.brand"]</span>
    <h1>SYT @T["app.name"]</h1>
    <span class="tagline">@T["app.tagline"]</span>
</header>

<main class="app-main">
    @Body
</main>
