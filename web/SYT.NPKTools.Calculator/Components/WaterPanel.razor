@inject CalculatorModel Model
@inject Translations T
@implements IDisposable

@*
    Everything about the source water: how it is described, and what that description implies. Lifted
    out of Home.razor because the block roughly tripled and the page should compose, not calculate.
*@

<section class="card">
    <h2>@T["water.title"]</h2>

    <div class="segmented" role="group" aria-label="@T["water.mode.aria"]">
        @foreach ((WaterInputMode mode, string key) in Modes)
        {
            <button type="button" class="@(Model.Mode == mode ? "on" : null)"
                    @onclick="() => Choose(mode)">@T[key]</button>
        }
    </div>

    @if (Model.Mode == WaterInputMode.Osmosis)
    {
        <p class="card-note" style="margin-top:0">@T["water.osmosis.note"]</p>
    }
    else if (Model.Mode == WaterInputMode.Analysis)
    {
        <p class="card-note" style="margin-top:0">@T["water.analysis.note"]</p>
        <ElementGrid Elements="ElementGroups.Macro" Values="Model.Water" Prefix="w"
                     Step="0.1" Columns="3" Changed="_ => Edited()" />
        <div class="group-divider">@T["water.group.micro"]</div>
        <ElementGrid Elements="ElementGroups.Micro" Values="Model.Water" Prefix="w"
                     Step="0.01" Columns="4" Changed="_ => Edited()" />
        <div class="group-divider">@T["target.counterIons"]</div>
        <ElementGrid Elements="ElementGroups.CounterIons" Values="Model.Water" Prefix="w"
                     Step="0.1" Columns="2" Changed="_ => Edited()" />
    }
    else
    {
        <div class="field">
            <label for="w-preset">@T["water.preset"]</label>
            @* Keyed by Id, not by the library's own Label: that prose is English and written for
               developers, the same reason the error messages moved. *@
            <select id="w-preset" value="@Model.WaterPresetId" @onchange="OnPresetChanged">
                @foreach (WaterPreset preset in WaterPreset.All)
                {
                    <option value="@preset.Id">@T[$"water.preset.{preset.Id}"]</option>
                }
            </select>
        </div>

        <div class="field-grid" style="margin-top:var(--grid-gap); --cols:2">
            <div class="field">
                <label for="w-ec">@T["water.meter"]</label>
                <input id="w-ec" type="number" min="0" step="0.01" value="@Model.WaterEc"
                       @onchange="OnEcChanged" />
            </div>
            <div class="field">
                <label for="w-unit">@T["water.scale"]</label>
                <select id="w-unit" value="@Model.WaterEcUnit" @onchange="OnUnitChanged">
                    <option value="@EcUnit.MilliSiemensPerCm">mS/cm</option>
                    <option value="@EcUnit.Ppm500">ppm (500)</option>
                    <option value="@EcUnit.Ppm700">ppm (700)</option>
                </select>
            </div>
        </div>

        @if (Model.Mode == WaterInputMode.ConductivityWithTests)
        {
            <div class="field-grid" style="margin-top:var(--grid-gap); --cols:2">
                <div class="field">
                    <label for="w-gh">@T["water.gh"]</label>
                    <input id="w-gh" type="number" min="0" step="0.5" value="@Model.WaterGh"
                           @onchange="OnGhChanged" />
                </div>
                <div class="field">
                    <label for="w-kh">@T["water.kh"]</label>
                    <input id="w-kh" type="number" min="0" step="0.5" value="@Model.WaterKh"
                           @onchange="OnKhChanged" />
                </div>
            </div>
            <p class="card-note">@T["water.tests.note"]</p>
        }

        @if (Model.WaterEstimate is { } estimate)
        {
            <div class="group-divider">@T["water.estimate.title"]</div>
            @* Three across, so the six read as two rows rather than four and a stray pair. *@
            <div class="field-grid" style="--cols:3">
                @foreach ((string symbol, double value) in Estimated(estimate))
                {
                    <div class="field">
                        <label>@symbol</label>
                        <div class="readout">@value.ToString("F1")</div>
                    </div>
                }
            </div>

            @if (!estimate.Feasible)
            {
                <div class="notice warn" role="status">
                    <Icon Kind="IconKind.Warning" />
                    <span>
                        <strong>@T["water.estimate.infeasible.lead"]</strong>
                        @T.Format(
                            "water.estimate.infeasible.detail",
                            estimate.MicroSiemensPerCm.ToString("F0"),
                            estimate.RequestedMicroSiemensPerCm.ToString("F0"))
                    </span>
                </div>
            }
            else if (estimate.RelativeError > 0.2)
            {
                <div class="notice warn" role="status">
                    <Icon Kind="IconKind.Warning" />
                    <span>
                        <strong>@T.Format(
                            "water.estimate.off.lead",
                            (estimate.RelativeError * 100).ToString("F0"))</strong>
                        @T["water.estimate.off.detail"]
                    </span>
                </div>
            }
        }
    }

    @if (Model.HasRun && Model.WaterConductivity is { } waterEc && waterEc.MicroSiemensPerCm > 0)
    {
        <div class="metrics" style="margin-top:8px">
            <div class="metric">
                <div class="label">@T["water.metric.ec"]</div>
                <div class="value">@waterEc.MicroSiemensPerCm.ToString("F0") <span class="unit">µS/cm</span></div>
            </div>
            <div class="metric">
                <div class="label">@T["water.metric.alkalinity"]</div>
                <div class="value">@Model.Alkalinity.ToString("F2") <span class="unit">meq/L</span></div>
            </div>
            <div class="metric">
                <div class="label">@T["water.metric.bicarbonate"]</div>
                <div class="value">@((Model.Alkalinity * 61).ToString("F0")) <span class="unit">ppm</span></div>
            </div>
        </div>

        @if (Model.Mode == WaterInputMode.Analysis)
        {
            <p class="card-note">@T["water.note.analysis"]</p>
        }
        else
        {
            <p class="card-note">@T["water.note.alkalinity"]</p>
        }
    }

    @if (Model.Excesses.Count > 0)
    {
        <div class="notice warn" role="status">
            <Icon Kind="IconKind.Warning" />
            <span>
                <strong>@T["water.excess.lead"]</strong>
                @T.Format("water.excess.detail", Excesses)
            </span>
        </div>
    }
</section>

@code {
    // Both events, because two different things make this panel out of date: a new calculation, and a
    // new language. Blazor skips a child whose parameters have not changed, and neither of those is a
    // parameter — see CalculatorModel.Changed for the whole story.
    protected override void OnInitialized()
    {
        Model.Changed += Redraw;
        T.Changed += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Model.Changed -= Redraw;
        T.Changed -= Redraw;
    }

    /// <summary>Raised after any edit, so the page can recalculate and persist.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private static readonly (WaterInputMode Mode, string Key)[] Modes =
    [
        (WaterInputMode.Osmosis, "water.mode.osmosis"),
        (WaterInputMode.Conductivity, "water.mode.ec"),
        (WaterInputMode.ConductivityWithTests, "water.mode.ecTests"),
        (WaterInputMode.Analysis, "water.mode.analysis"),
    ];

    // Each entry is its own sentence fragment in a language that puts "target" somewhere else, so it
    // goes through a key too rather than being interpolated here.
    private string Excesses =>
        string.Join(
            ", ",
            Model.Excesses.Select(x => T.Format(
                "water.excess.item",
                x.Element,
                x.InWater.ToString("F0"),
                x.Target.ToString("F0"))));

    private static IEnumerable<(string Symbol, double Value)> Estimated(WaterEstimate estimate) =>
    [
        ("Ca", estimate.Profile.Calcium.Value),
        ("Mg", estimate.Profile.Magnesium.Value),
        ("Na", estimate.Profile.Sodium.Value),
        ("S", estimate.Profile.Sulfur.Value),
        ("Cl", estimate.Profile.Chlorine.Value),
        ("N", estimate.Profile.Nitrogen.Nitrate),
    ];

    private Task Choose(WaterInputMode mode)
    {
        Model.Mode = mode;

        if (mode is WaterInputMode.Conductivity or WaterInputMode.ConductivityWithTests)
        {
            Model.SeedReadingFromPreset();
        }

        return Edited();
    }

    private Task OnPresetChanged(ChangeEventArgs e)
    {
        Model.WaterPresetId = e.Value?.ToString() ?? Model.WaterPresetId;
        Model.SeedReadingFromPreset();
        return Edited();
    }

    private Task OnEcChanged(ChangeEventArgs e)
    {
        Model.WaterEc = Numbers.ParseOrNull(e.Value) ?? 0;
        return Edited();
    }

    private Task OnUnitChanged(ChangeEventArgs e)
    {
        Model.WaterEcUnit = Enum.TryParse(e.Value?.ToString(), out EcUnit unit)
            ? unit
            : EcUnit.MilliSiemensPerCm;
        return Edited();
    }

    private Task OnGhChanged(ChangeEventArgs e)
    {
        Model.WaterGh = Numbers.ParseOrNull(e.Value);
        return Edited();
    }

    private Task OnKhChanged(ChangeEventArgs e)
    {
        Model.WaterKh = Numbers.ParseOrNull(e.Value);
        return Edited();
    }

    private Task Edited() => Changed.InvokeAsync();
}
