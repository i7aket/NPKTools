@inject CalculatorModel Model
@inject Translations T
@implements IDisposable

@*
    Only shown when there is alkalinity to neutralise, because on reverse osmosis there is nothing to
    decide. The pH fields are the one place a pH reading carries information: it locates the water on
    its titration curve. It says nothing about composition, which is why it is an input nowhere else.
*@

@if (Model.Alkalinity > 0)
{
    <section class="card">
        <h2>@T["acid.title"]</h2>

        <label class="salt-row" style="padding-left:0">
            <input type="checkbox" checked="@Model.AcidEnabled" @onchange="OnEnabledChanged" />
            <span>@T.Format("acid.enable", Model.Alkalinity.ToString("F2"))</span>
        </label>

        @if (Model.AcidEnabled)
        {
            <div class="field" style="margin-top:var(--grid-gap)">
                <label for="acid">@T["acid.acid"]</label>
                <select id="acid" value="@Model.AcidId" @onchange="OnAcidChanged">
                    @foreach (Acid acid in Acid.All)
                    {
                        <option value="@acid.Id">@Name(acid)</option>
                    }
                </select>
            </div>

            <div class="field-grid" style="margin-top:var(--grid-gap)">
                <div class="field">
                    <label for="ph-water">@T["acid.waterPh"]</label>
                    <input id="ph-water" type="number" min="0" max="14" step="0.1"
                           value="@Model.WaterPh" @onchange="OnWaterPhChanged" />
                </div>
                <div class="field">
                    <label for="ph-target">@T["acid.targetPh"]</label>
                    <input id="ph-target" type="number" min="0" max="14" step="0.1"
                           value="@Model.TargetPh" @onchange="OnTargetPhChanged" />
                </div>
            </div>

            @if (Model.Acid is { } plan)
            {
                <div class="metrics" style="margin-top:8px">
                    <div class="metric">
                        <div class="label">@T["acid.metric.volume"]</div>
                        <div class="value">@plan.Millilitres.ToString("F1") <span class="unit">mL</span></div>
                    </div>
                    <div class="metric">
                        <div class="label">@T["acid.metric.strength"]</div>
                        <div class="value">@plan.MilliequivalentsPerLitre.ToString("F2") <span class="unit">meq/L</span></div>
                    </div>
                    <div class="metric">
                        <div class="label">@T.Format("acid.metric.adds", plan.NutrientSymbol)</div>
                        <div class="value">@plan.NutrientPpm.ToString("F0") <span class="unit">ppm</span></div>
                    </div>
                </div>

                @if (Overshoots(plan))
                {
                    <div class="notice warn" role="status">
                        <Icon Kind="IconKind.Warning" />
                        <span>
                            <strong>@T.Format("acid.overshoot.lead", plan.NutrientSymbol)</strong>
                            @T.Format(
                                "acid.overshoot.detail",
                                plan.NutrientPpm.ToString("F0"),
                                Model.TargetFields[plan.NutrientSymbol].ToString("F0"))
                            @if (Fits() is { } better)
                            {
                                @* An entity rather than a space: Razor drops literal whitespace between
                                   an expression and the block that follows, which ran the two sentences
                                   together. An entity is markup, so it survives. *@
                                <text>&#32;@T.Format("acid.overshoot.alternative", Name(better))</text>
                            }
                        </span>
                    </div>
                }

                <p class="card-note">
                    @T.Format(
                        "acid.note",
                        plan.NutrientSymbol,
                        Model.Alkalinity.ToString("F2"),
                        (Model.Alkalinity * 44.5).ToString("F0"))
                </p>
            }
        }
    </section>
}

@code {
    // Both events, because two different things make this panel out of date: a new calculation, and a
    // new language. Blazor skips a child whose parameters have not changed, and neither of those is a
    // parameter — see CalculatorModel.Changed for the whole story.
    protected override void OnInitialized()
    {
        Model.Changed += Redraw;
        T.Changed += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Model.Changed -= Redraw;
        T.Changed -= Redraw;
    }

    /// <summary>Raised after any edit, so the page can recalculate and persist.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    // Named by kind with the strength filled in, rather than by the library's own Label: "60%" is
    // written "%60" in Turkish, and one key per kind is three to translate instead of six.
    private string Name(Acid acid) =>
        T.Format($"acid.kind.{acid.Kind}", acid.PercentByWeight.ToString("0.##"));

    private bool Overshoots(AcidPlan plan) =>
        Model.TargetFields.TryGetValue(plan.NutrientSymbol, out double target)
        && target > 0
        && plan.NutrientPpm > target;

    // The same neutralisation delivered by a different acid lands on a different element, so there is
    // usually one that fits. Naming it is more use than telling somebody to go and look.
    private Acid? Fits() =>
        Model.Acid is not { } plan
            ? null
            : Acid.All.FirstOrDefault(candidate =>
                Model.TargetFields.TryGetValue(candidate.NutrientSymbol, out double target)
                && target > 0
                && plan.MilliequivalentsPerLitre * candidate.MilligramsOfNutrientPerMilliequivalent
                    <= target);

    private Task OnEnabledChanged(ChangeEventArgs e)
    {
        Model.AcidEnabled = e.Value is true;
        return Changed.InvokeAsync();
    }

    private Task OnAcidChanged(ChangeEventArgs e)
    {
        Model.AcidId = e.Value?.ToString() ?? Model.AcidId;
        return Changed.InvokeAsync();
    }

    private Task OnWaterPhChanged(ChangeEventArgs e)
    {
        Model.WaterPh = Ph(e.Value, Model.WaterPh);
        return Changed.InvokeAsync();
    }

    private Task OnTargetPhChanged(ChangeEventArgs e)
    {
        Model.TargetPh = Ph(e.Value, Model.TargetPh);
        return Changed.InvokeAsync();
    }
    // pH is the one figure with a meaningful range, so an out-of-range entry keeps the previous
    // value rather than reading as zero — which would silently mean "strongly acidic".
    private static double Ph(object? value, double fallback) =>
        Numbers.TryParse(value, out double parsed) && parsed is >= 0 and <= 14 ? parsed : fallback;
}
