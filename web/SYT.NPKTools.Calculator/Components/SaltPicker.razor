@inject CalculatorModel Model
@inject Translations T
@implements IDisposable

@*
    The shelf. Lifted out of Home.razor because a list plus an entry form is more than a page should
    hold inline, and the grouping is not ours to decide — FertilizerBundleGenerator.IsMicro classifies
    by composition, so a salt the grower adds lands in the right group without a flag to get wrong.
*@

<section class="card">
    <h2>@FormattedTitle</h2>

    <div class="button-row" style="margin-top:0">
        <button class="secondary" @onclick="SelectAll">@T["salts.all"]</button>
        <button class="secondary" @onclick="SelectNone">@T["salts.none"]</button>
        <button @onclick="() => _adding = !_adding">@(_adding ? T["salts.close"] : T["salts.add"])</button>
    </div>

    @if (_adding)
    {
        <div class="group-divider">@T["salts.own"]</div>
        <CustomSaltForm Changed="Changed" Cancelled="() => _adding = false" />
    }

    <div class="salt-list">
        @foreach (IGrouping<bool, Fertilizer> group in Model.Catalogue
            .GroupBy(FertilizerBundleGenerator.IsMicro)
            .OrderBy(g => g.Key))
        {
            <div class="salt-group">@(group.Key ? T["salts.group.micro"] : T["salts.group.macro"])</div>
            @foreach (Fertilizer salt in group)
            {
                <label class="salt-row">
                    <input type="checkbox" checked="@Model.Selected.Contains(salt.Name.Value)"
                           @onchange="e => OnToggled(salt.Name.Value, e)" />
                    <span>@salt.Name.Value</span>
                    @if (IsCustom(salt))
                    {
                        <button class="secondary tiny" title="@T["salts.remove"]"
                                @onclick:preventDefault @onclick:stopPropagation
                                @onclick="() => Remove(salt.Name.Value)">✕</button>
                    }
                    <span class="formula">@salt.Formula.Value</span>
                </label>
            }
        }
    </div>

    @if (Model.UncoveredElements.Count > 0)
    {
        <div class="notice warn" role="status">
            <Icon Kind="IconKind.Warning" />
            <span>
                <strong>@T["salts.uncovered.lead"]</strong> @string.Join(", ", Model.UncoveredElements).
                @T["salts.uncovered.note"]
            </span>
        </div>
    }
</section>

@code {
    // Both events, because two different things make this panel out of date: a new calculation, and a
    // new language. Blazor skips a child whose parameters have not changed, and neither of those is a
    // parameter — see CalculatorModel.Changed for the whole story.
    protected override void OnInitialized()
    {
        Model.Changed += Redraw;
        T.Changed += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Model.Changed -= Redraw;
        T.Changed -= Redraw;
    }

    /// <summary>Raised after any edit, so the page can recalculate and persist.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private bool _adding;

    // One key with both numbers in it: a translator cannot reorder a title assembled in markup.
    private string FormattedTitle =>
        T["salts.title"]
            .Replace("{0}", Model.Selected.Count.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)
            .Replace("{1}", Model.Catalogue.Count.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal);

    private bool IsCustom(Fertilizer salt) =>
        Model.CustomSalts.Any(c => string.Equals(c.Name, salt.Name.Value, StringComparison.Ordinal));

    private Task OnToggled(string name, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            Model.Selected.Add(name);
        }
        else
        {
            Model.Selected.Remove(name);
        }

        return Changed.InvokeAsync();
    }

    private Task Remove(string name)
    {
        Model.RemoveCustomSalt(name);
        return Changed.InvokeAsync();
    }

    private Task SelectAll()
    {
        foreach (Fertilizer salt in Model.Catalogue)
        {
            Model.Selected.Add(salt.Name.Value);
        }

        return Changed.InvokeAsync();
    }

    private Task SelectNone()
    {
        Model.Selected.Clear();
        return Changed.InvokeAsync();
    }
}
