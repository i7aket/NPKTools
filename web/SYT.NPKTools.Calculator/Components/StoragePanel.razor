@*
    The three ways a setup persists, each answering a different question. See CalculatorState for why
    all three exist rather than one.
*@

@inject CalculatorModel Model
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="card">
    <h2>Save &amp; transfer</h2>

    <p class="card-note" style="margin-top:0">
        Everything stays on this device — there is no server to sync to.
    </p>

    @*
        One word each, so the four sit on one row instead of wrapping into a block. "Open" rather than
        "Upload": nothing is uploaded anywhere, and the note directly above promises exactly that.
        What each one is for is spelled out under "Which one to use" below.
    *@
    <div class="button-row">
        <button @onclick="CopyLink">@(_copied ? "Copied" : "Link")</button>
        <a class="download" href="@DataUrl()" download="npktools-recipe.json">Download</a>
        <button class="secondary" @onclick="() => _loading = !_loading">Open</button>
        <button class="secondary" @onclick="Forget">Forget</button>
    </div>

    @if (_loading)
    {
        <div style="margin-top:8px">
            <InputFile OnChange="OnFilePicked" accept=".json" aria-label="Choose a saved recipe file" />
        </div>
    }

    @if (_message is not null)
    {
        <div class="notice @_messageKind" role="status">
            <Icon Kind="@(_messageKind == "error" ? IconKind.Error : IconKind.Info)" />
            <span>@_message</span>
        </div>
    }

    <details style="margin-top:8px">
        <summary>Which one to use</summary>
        <p class="card-note">
            <strong>Automatic.</strong> This browser remembers your last setup, so closing the tab loses
            nothing. It cannot reach another browser — that is how browser storage works, not a limit of
            this app.
        </p>
        <p class="card-note">
            <strong>The link</strong> carries the whole setup in the address. Copy it into another browser,
            another device, or a message to someone else. It is also what to bookmark to keep several
            targets a click apart.
        </p>
        <p class="card-note">
            <strong>The file</strong> is plain JSON you can keep, edit and re-load. Unlike the other two it
            survives clearing site data, which makes it the one to use for a recipe you rely on.
        </p>
    </details>
</section>

@code {
    private IJSObjectReference? _module;
    private bool _writing;
    private bool _copied;
    private bool _loading;
    private string? _message;
    private string _messageKind = "info";

    /// <summary>Raised after loading a file or a link, so the page can re-render the results.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/storage.js");

        // Pasting a link into an already-open tab changes only the fragment, and a fragment-only change
        // does not reload the page — so reading the address once at startup would silently ignore exactly
        // the way a shared link gets used. Hence the subscription.
        Navigation.LocationChanged += OnLocationChanged;

        if (!ApplyLink())
        {
            CalculatorState? saved = CalculatorState.FromJson(await _module.InvokeAsync<string?>("load"));
            if (saved is not null)
            {
                Model.Apply(saved);
            }
        }

        Model.Recalculate();
        await Persist();
        await Changed.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Reads the address and applies it, if it carries a setup.
    /// </summary>
    /// <returns>True when a link was applied, so the caller knows not to fall back to local storage.</returns>
    /// <remarks>
    /// The link wins over what this browser remembers: someone opening a shared address expects to see
    /// that setup rather than their own, and their own is still in local storage one bare reload away.
    /// </remarks>
    private bool ApplyLink()
    {
        (CalculatorState? state, bool saltsUsable) =
            CalculatorState.FromFragment(new Uri(Navigation.Uri).Fragment, Model.CatalogueNames);

        if (state is null)
        {
            return false;
        }

        Model.Apply(state);
        _message = null;

        if (!saltsUsable)
        {
            Show("This link was made with a different version of the salt catalogue, so its salt "
                + "selection was ignored and everything is ticked. The rest of the link was applied.",
                "error");
        }

        return true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Persist() rewrites the address on every edit, so most of these events are the app's own doing.
        // Applying the fragment then is harmless — it decodes to what is already on screen — but doing the
        // work and re-rendering on every keystroke is not, so only a change that differs is acted on.
        if (_writing)
        {
            return;
        }

        if (ApplyLink())
        {
            Model.Recalculate();
            _ = InvokeAsync(async () =>
            {
                await Changed.InvokeAsync();
                StateHasChanged();
            });
        }
    }

    /// <summary>Writes the current setup to local storage and to the address bar.</summary>
    public async Task Persist()
    {
        CalculatorState state = Model.Capture();

        // replaceHistoryEntry, not a push: every keystroke would otherwise need its own Back press to
        // undo, which turns the browser's back button into an edit history nobody asked for.
        _writing = true;
        try
        {
            Navigation.NavigateTo(
                $"{Navigation.BaseUri}#{state.ToFragment(Model.CatalogueNames)}",
                forceLoad: false,
                replace: true);
        }
        finally
        {
            _writing = false;
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("save", state.ToJson());
        }

        _copied = false;
    }

    private string DataUrl()
    {
        string encoded = Uri.EscapeDataString(Model.Capture().ToJson());
        return $"data:application/json;charset=utf-8,{encoded}";
    }

    private async Task CopyLink()
    {
        if (_module is null)
        {
            return;
        }

        _copied = await _module.InvokeAsync<bool>("copy", Navigation.Uri);
        Show(_copied
            ? "Link copied. Paste it into any browser to reopen this setup."
            : "Could not reach the clipboard — copy the address bar by hand instead.",
            _copied ? "info" : "error");
    }

    private async Task OnFilePicked(InputFileChangeEventArgs e)
    {
        // 64 KB is far more than a state file needs and small enough that a mis-picked video cannot
        // stall the tab reading it.
        using StreamReader reader = new(e.File.OpenReadStream(64 * 1024));
        CalculatorState? state = CalculatorState.FromJson(await reader.ReadToEndAsync());

        if (state is null)
        {
            Show("That file is not a saved recipe.", "error");
            return;
        }

        Model.Apply(state);
        Model.Recalculate();
        await Persist();
        _loading = false;
        Show($"Loaded {e.File.Name}.", "info");
        await Changed.InvokeAsync();
    }

    private async Task Forget()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("clear");
        }

        Show("This browser will no longer remember your setup. The current one is still on screen.", "info");
    }

    private void Show(string message, string kind)
    {
        _message = message;
        _messageKind = kind;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away; the module went with it.
            }
        }
    }
}
