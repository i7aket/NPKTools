@*
    The three ways a setup persists, each answering a different question. See CalculatorState for why
    all three exist rather than one.
*@

@inject CalculatorModel Model
@inject Translations T
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="card">
    <h2>@T["storage.title"]</h2>

    <p class="card-note" style="margin-top:0">@T["storage.note"]</p>

    @*
        One word each, so the four sit on one row instead of wrapping into a block. "Open" rather than
        "Upload": nothing is uploaded anywhere, and the note directly above promises exactly that.
        What each one is for is spelled out under "Which one to use" below.
    *@
    <div class="button-row">
        <button @onclick="CopyLink">@(_copied ? T["storage.copied"] : T["storage.link"])</button>
        <a class="download" href="@DataUrl()" download="npktools-recipe.json">@T["storage.download"]</a>
        <button class="secondary" @onclick="() => _loading = !_loading">@T["storage.open"]</button>
        <button class="secondary" @onclick="Forget">@T["storage.forget"]</button>
    </div>

    @if (_loading)
    {
        <div style="margin-top:8px">
            <InputFile OnChange="OnFilePicked" accept=".json" aria-label="@T["storage.choose"]" />
        </div>
    }

    @if (_messageKey is { } messageKey)
    {
        <div class="notice @_messageKind" role="status">
            <Icon Kind="@(_messageKind == "error" ? IconKind.Error : IconKind.Info)" />
            <span>@T.Format(messageKey, _messageArgument ?? string.Empty)</span>
        </div>
    }

    <details style="margin-top:8px">
        <summary>@T["storage.which"]</summary>
        @*
            "Automatic." keeps its bold because it is a sentence of its own. The other two lost theirs:
            the bold sat on the subject of a sentence — "<strong>The link</strong> carries…" — and a
            sentence a translator cannot reorder is a sentence they cannot translate.
        *@
        <p class="card-note">
            <strong>@T["storage.auto.lead"]</strong> @T["storage.auto.body"]
        </p>
        <p class="card-note">@T["storage.link.note"]</p>
        <p class="card-note">@T["storage.file.note"]</p>
    </details>
</section>

@code {
    // The download link's href is built from the current setup at render time, so this panel has to be
    // redrawn when the setup changes — otherwise the file offered is the one from startup. Blazor skips
    // a child whose parameters have not changed; see CalculatorModel.Changed.
    private void Redraw() => InvokeAsync(StateHasChanged);

    private IJSObjectReference? _module;
    private bool _writing;
    private bool _copied;
    private bool _loading;
    private string? _messageKey;
    private string? _messageArgument;
    private string _messageKind = "info";

    /// <summary>Raised after loading a file or a link, so the page can re-render the results.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    protected override void OnInitialized() => Model.Changed += Redraw;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/storage.js");

        // Pasting a link into an already-open tab changes only the fragment, and a fragment-only change
        // does not reload the page — so reading the address once at startup would silently ignore exactly
        // the way a shared link gets used. Hence the subscription.
        Navigation.LocationChanged += OnLocationChanged;

        if (!ApplyLink())
        {
            CalculatorState? saved = CalculatorState.FromJson(await _module.InvokeAsync<string?>("load"));
            if (saved is not null)
            {
                Model.Apply(saved);
            }
        }

        Model.Recalculate();
        await Persist();
        await Changed.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Reads the address and applies it, if it carries a setup.
    /// </summary>
    /// <returns>True when a link was applied, so the caller knows not to fall back to local storage.</returns>
    /// <remarks>
    /// The link wins over what this browser remembers: someone opening a shared address expects to see
    /// that setup rather than their own, and their own is still in local storage one bare reload away.
    /// </remarks>
    private bool ApplyLink()
    {
        (CalculatorState? state, bool saltsUsable) =
            CalculatorState.FromFragment(new Uri(Navigation.Uri).Fragment, Model.CatalogueNames);

        if (state is null)
        {
            return false;
        }

        Model.Apply(state);
        _messageKey = null;

        if (!saltsUsable)
        {
            Show("storage.msg.saltsIgnored", "error");
        }

        return true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Persist() rewrites the address on every edit, so most of these events are the app's own doing.
        // Applying the fragment then is harmless — it decodes to what is already on screen — but doing the
        // work and re-rendering on every keystroke is not, so only a change that differs is acted on.
        if (_writing)
        {
            return;
        }

        if (ApplyLink())
        {
            Model.Recalculate();
            _ = InvokeAsync(async () =>
            {
                await Changed.InvokeAsync();
                StateHasChanged();
            });
        }
    }

    /// <summary>Writes the current setup to local storage and to the address bar.</summary>
    public async Task Persist()
    {
        CalculatorState state = Model.Capture();

        // replaceHistoryEntry, not a push: every keystroke would otherwise need its own Back press to
        // undo, which turns the browser's back button into an edit history nobody asked for.
        _writing = true;
        try
        {
            Navigation.NavigateTo(
                $"{Navigation.BaseUri}#{state.ToFragment(Model.CatalogueNames)}",
                forceLoad: false,
                replace: true);
        }
        finally
        {
            _writing = false;
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("save", state.ToJson());
        }

        _copied = false;
    }

    private string DataUrl()
    {
        string encoded = Uri.EscapeDataString(Model.Capture().ToJson());
        return $"data:application/json;charset=utf-8,{encoded}";
    }

    private async Task CopyLink()
    {
        if (_module is null)
        {
            return;
        }

        _copied = await _module.InvokeAsync<bool>("copy", Navigation.Uri);
        Show(
            _copied ? "storage.msg.copied" : "storage.msg.clipboardFailed",
            _copied ? "info" : "error");
    }

    private async Task OnFilePicked(InputFileChangeEventArgs e)
    {
        // 64 KB is far more than a state file needs and small enough that a mis-picked video cannot
        // stall the tab reading it.
        using StreamReader reader = new(e.File.OpenReadStream(64 * 1024));
        CalculatorState? state = CalculatorState.FromJson(await reader.ReadToEndAsync());

        if (state is null)
        {
            Show("storage.msg.notARecipe", "error");
            return;
        }

        Model.Apply(state);
        Model.Recalculate();
        await Persist();
        _loading = false;
        Show("storage.msg.loaded", "info", e.File.Name);
        await Changed.InvokeAsync();
    }

    private async Task Forget()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("clear");
        }

        Show("storage.msg.forgotten", "info");
    }

    // The key rather than the words, so the notice is in the reader's language and stays in it when
    // they change language while it is on screen.
    private void Show(string key, string kind, string? argument = null)
    {
        _messageKey = key;
        _messageKind = kind;
        _messageArgument = argument;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Model.Changed -= Redraw;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The page is going away; the module went with it.
            }
        }
    }
}
