@page "/not-found"
@layout MainLayout
@inject Translations T
@implements IDisposable

<h3>@T["notFound.heading"]</h3>
<p>@T["notFound.body"]</p>

@code {
    // Redrawn when the language changes. Its parameters do not change then, and Blazor skips a child
    // whose parameters have not changed, so without this it would keep the words it was built with.
    protected override void OnInitialized() => T.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => T.Changed -= Redraw;
}
