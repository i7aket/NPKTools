<Project>

  <!--
    Central Package Management: every NuGet version used in the repository is
    declared here once. Projects reference packages without a Version attribute.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    The only dependency of the shipped package. Declared at 10.0.0 rather than the newest patch on
    purpose: for a library this is a floor, and raising it would force consumers onto a later runtime
    patch for no benefit.
  -->
  <ItemGroup Label="Product">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!--
      Google OR-Tools is test-only: it backs the GLOP oracle the shipped managed solver is
      differentially validated against, and the benchmark baseline. It is never distributed, because
      it has no browser-wasm build and would make the package server-only.
    -->
    <PackageVersion Include="Google.OrTools" Version="9.15.6755" />
    <!--
      AwesomeAssertions is the Apache-2.0 community fork of FluentAssertions 7.
      FluentAssertions 8+ requires a paid commercial licence, so it is deliberately not used.
    -->
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
