<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The package id deliberately keeps its historical name so existing consumers get 2.0.0 as an
      ordinary update rather than having to switch packages. It therefore does not match the
      assembly and namespace (NPKTools.PPMCalc) — a known inconsistency kept for compatibility.
    -->
    <PackageId>NPKTools.Optimizer.PPMCalc</PackageId>
    <Description>Calculates the concentration of each nutrient in parts per million (ppm) for a collection of fertilizers dissolved in a given volume of water.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPKTools.Core\NPKTools.Core.csproj" />
  </ItemGroup>

</Project>
