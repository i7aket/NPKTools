<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NPKTools.Optimizer.Preset</PackageId>
    <Description>A preconfigured NPKTools.Optimizer. Ships 17 macronutrient fertilizers combined into 18 bundles and 17 micronutrient fertilizers grouped into basic, sulfate, nitrate and chelated sets. Macronutrient searches run twice: once honouring the sulfur target, once ignoring it to widen the set of feasible mixes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPKTools.Core\NPKTools.Core.csproj" />
    <ProjectReference Include="..\NPKTools.Optimizer\NPKTools.Optimizer.csproj" />
  </ItemGroup>

</Project>
