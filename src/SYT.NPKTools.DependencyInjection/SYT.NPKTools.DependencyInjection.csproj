<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SYT.NPKTools.DependencyInjection</PackageId>
    <Title>SYT NPKTools Dependency Injection</Title>
    <Description>Adds a one-line AddNpkTools() registration for SYT.NPKTools to Microsoft.Extensions.DependencyInjection. This package exists only to keep SYT.NPKTools itself free of dependencies — everything here can be done by hand against the NpkTools factory, so take it only if you want the extension method.</Description>
    <RootNamespace>SYT.NPKTools.DependencyInjection</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SYT.NPKTools\SYT.NPKTools.csproj" />
  </ItemGroup>

</Project>
