<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SYT.NPKTools</PackageId>
    <Title>SYT NPKTools</Title>
    <Description>Fertilizer nutrient management for .NET. Works out how much of each fertilizer to use to hit a target PPM profile by solving the mix as a linear program, and calculates the PPM of a given mixture. Ships a curated catalogue of 34 fertilizers and 22 blending scenarios, a target-string parser, and a fully managed simplex solver with no native dependencies — so the whole pipeline also runs under WebAssembly.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!--
    The unit tests exercise two internal helpers directly: ThrowIf's guard clauses, and
    ReportFormatter's culture handling — the latter is the regression test for a shipped bug, so it
    asserts on the formatter itself rather than only through the public report methods.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SYT.NPKTools.Tests" />
  </ItemGroup>

</Project>
