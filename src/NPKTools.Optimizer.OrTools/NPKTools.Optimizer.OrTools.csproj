<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NPKTools.Optimizer.OrTools</PackageId>
    <Description>Google OR-Tools (GLOP) backend for NPKTools.Optimizer. Optional: NPKTools.Optimizer ships a fully managed simplex solver by default. Install this package only if you specifically want GLOP — it brings native binaries and therefore restricts you to linux-x64/arm64, osx-x64/arm64 and win-x64.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.OrTools" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPKTools.Core\NPKTools.Core.csproj" />
    <ProjectReference Include="..\NPKTools.Optimizer\NPKTools.Optimizer.csproj" />
  </ItemGroup>

</Project>
