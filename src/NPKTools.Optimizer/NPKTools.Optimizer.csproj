<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NPKTools.Optimizer</PackageId>
    <Description>Adjusts the ratio of each fertilizer in a collection to hit a desired PPM profile, solving the mix as a linear program. Fully managed with no native dependencies, so it runs anywhere .NET runs — including WebAssembly. Install NPKTools.Optimizer.OrTools if you want the Google OR-Tools GLOP backend instead.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPKTools.Core\NPKTools.Core.csproj" />
  </ItemGroup>

</Project>
